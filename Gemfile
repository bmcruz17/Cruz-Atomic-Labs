source "https://rubygems.org"

# Matches the Jekyll version and plugins GitHub Pages uses to build this site.
# See https://pages.github.com/versions/ before changing.
gem "github-pages", "~> 232", group: :jekyll_plugins

# Ruby 3+ no longer bundles webrick, which `jekyll serve` needs.
gem "webrick", "~> 1.9"

group :test do
  gem "html-proofer", "~> 5.0"
  gem "minitest", "~> 5.0"
  gem "rake", "~> 13.0"
end
